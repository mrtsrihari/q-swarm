# Q-Swarm RL Configuration Template
# Copy this file to .env to configure local environment variables.
# NEVER commit your actual .env file or API tokens to git.

# Quantum Cloud Credentials (OPTIONAL - only required for hardware inference)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CHANNEL=ibm_quantum
IBM_QUANTUM_INSTANCE=

# Execution Settings
QSWARM_LOG_LEVEL=INFO
QSWARM_SEED=42
QSWARM_NUM_WORKERS=1
QSWARM_BACKEND=simulator # simulator | noisy_simulator | ibm_hardware
